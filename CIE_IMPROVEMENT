# style.css
*{
background: rgb(129, 129, 207);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
    }
    form {
      background:white;
      padding: 25px;
      border-radius: 10px;
      width: 350px;
    }
  
    input {
      width: 95%;
